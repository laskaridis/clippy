{
    "name": "webclipper-devcontainer",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev-sandbox",

    "workspaceFolder": "/workspace",

    "remoteUser": "vscode",
    "containerUser": "vscode",

    "remoteEnv": {
    },

    "postCreateCommand": "bash .devcontainer/bootstrap.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.ruff"
            ]
        }
    }
}
