#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_FEATURE_BRANCH_CHECK:-0}" == "1" ]]; then
  exit 0
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  exit 0
fi

if ! branch_name="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
  # Detached HEAD (e.g., rebase/cherry-pick) should not be blocked.
  exit 0
fi

if [[ "${branch_name}" =~ ^feature/[a-z0-9-]+$ ]]; then
  :
else
  cat >&2 <<EOF
[pre-commit] Branch name '${branch_name}' is invalid for feature work.
[pre-commit] Use: feature/<short-description-of-feature> (lowercase letters, numbers, hyphens).
[pre-commit] Example: git checkout -b feature/improve-branch-policy
[pre-commit] If this commit is intentionally not feature work, run with SKIP_FEATURE_BRANCH_CHECK=1.
EOF

  exit 1
fi

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

staged_files=()
while IFS= read -r file; do
  staged_files+=("${file}")
done < <(git diff --cached --name-only --diff-filter=ACMR)
if [[ "${#staged_files[@]}" -eq 0 ]]; then
  exit 0
fi

backend_python_files=()
extension_ts_files=()
for file in "${staged_files[@]}"; do
  if [[ "${file}" =~ ^backend/.*\.py$ ]]; then
    backend_python_files+=("${file#backend/}")
  fi
  if [[ "${file}" =~ ^extension/chrome/src/.*\.ts$ ]]; then
    extension_ts_files+=("${file#extension/}")
  fi
done

stash_unstaged_changes() {
  local before_stash_ref=""
  local after_stash_ref=""

  if [[ "$#" -eq 0 ]]; then
    echo ""
    return 0
  fi

  if git diff --quiet -- "$@"; then
    echo ""
    return 0
  fi

  before_stash_ref="$(git rev-parse --verify --quiet refs/stash || true)"
  git stash push --quiet --keep-index --message "pre-commit-unstaged-$RANDOM-$RANDOM" -- "$@"
  after_stash_ref="$(git rev-parse --verify --quiet refs/stash || true)"

  if [[ -z "${after_stash_ref}" || "${after_stash_ref}" == "${before_stash_ref}" ]]; then
    echo "[pre-commit] failed to stash unstaged changes" >&2
    exit 1
  fi

  echo "${after_stash_ref}"
}

restore_unstaged_changes() {
  local stash_ref="$1"

  if [[ -z "${stash_ref}" ]]; then
    return 0
  fi

  if ! git stash pop --quiet "${stash_ref}"; then
    echo "[pre-commit] failed to restore unstaged changes (stash: ${stash_ref})" >&2
    echo "[pre-commit] resolve conflicts and restore your changes manually from the stash entry above" >&2
    exit 1
  fi
}

if [[ "${#backend_python_files[@]}" -gt 0 ]]; then
  backend_repo_files=()
  for file in "${backend_python_files[@]}"; do
    backend_repo_files+=("backend/${file}")
  done
  backend_stash_ref="$(stash_unstaged_changes "${backend_repo_files[@]}")"

  echo "[pre-commit] formatting backend python files (black)"
  if ! (
    cd backend
    python -m black "${backend_python_files[@]}"
    python -m ruff check --fix "${backend_python_files[@]}"
  ); then
    restore_unstaged_changes "${backend_stash_ref}"
    exit 1
  fi
  git add -- "${backend_repo_files[@]}"
  restore_unstaged_changes "${backend_stash_ref}"
fi

if [[ "${#extension_ts_files[@]}" -gt 0 ]]; then
  extension_repo_files=()
  for file in "${extension_ts_files[@]}"; do
    extension_repo_files+=("extension/${file}")
  done
  extension_stash_ref="$(stash_unstaged_changes "${extension_repo_files[@]}")"

  echo "[pre-commit] formatting extension files (prettier)"
  if ! (
    cd extension
    pnpm exec prettier --write "${extension_ts_files[@]}"
    pnpm exec eslint --fix "${extension_ts_files[@]}"
  ); then
    restore_unstaged_changes "${extension_stash_ref}"
    exit 1
  fi
  git add -- "${extension_repo_files[@]}"
  restore_unstaged_changes "${extension_stash_ref}"
fi

echo "[pre-commit] checks complete"
