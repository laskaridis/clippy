#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_FEATURE_BRANCH_CHECK:-0}" == "1" ]]; then
  exit 0
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  exit 0
fi

if ! branch_name="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
  # Detached HEAD (e.g., rebase/cherry-pick) should not be blocked.
  exit 0
fi

if [[ "${branch_name}" =~ ^feature/[a-z0-9-]+$ ]]; then
  exit 0
fi

cat >&2 <<EOF
[pre-commit] Branch name '${branch_name}' is invalid for feature work.
[pre-commit] Use: feature/<short-description-of-feature> (lowercase letters, numbers, hyphens).
[pre-commit] Example: git checkout -b feature/improve-branch-policy
[pre-commit] If this commit is intentionally not feature work, run with SKIP_FEATURE_BRANCH_CHECK=1.
EOF

exit 1
