#!/usr/bin/env bash

# Store the current script directory:
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Calculate the location of docker-compose.yml relative to SCRIPT_DIR:
DOCKER_COMPOSE_FILE="$(realpath "$SCRIPT_DIR/../docker-compose.yml")"

# Start docker compose stack using the SANDBOX_ID project name:
docker compose -f "$DOCKER_COMPOSE_FILE" down -v