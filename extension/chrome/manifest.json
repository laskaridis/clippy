{
  "manifest_version": 3,
  "name": "WebClippings",
  "version": "0.1.0",
  "description": "Capture selected text as clippings and send to the WebClippings app.",
  "permissions": ["activeTab", "contextMenus"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.example.com/*"
  ],
  "action": {
    "default_title": "Save clipping",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "dist/background/clip_sender.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "dist/shared/messages.js",
        "dist/content/clipSelection.js",
        "dist/content/messageHandlers.js",
        "dist/content/clipper.js"
      ]
    }
  ]
}
